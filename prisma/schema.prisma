generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  saves     Save[]
  createdAt DateTime @default(now())
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
