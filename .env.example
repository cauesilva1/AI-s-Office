# Copie para .env.local — keys nunca vão para o browser se ALLOW_CLIENT_KEYS=false

# Provedor opcional default (só documentação; a UI escolhe)
# AI_PROVIDER=huggingface

HF_TOKEN=
# HUGGINGFACE_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# true (default) = aceita key do localStorage
# false = só env do servidor (melhor p/ multi-user / deploy)
ALLOW_CLIENT_KEYS=true
